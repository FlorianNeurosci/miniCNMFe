    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"mean_t = arr.mean(axis=(1, 2))\\n\",\n",
    "    \"std_t  = arr.std(axis=(1, 2))\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, axes = plt.subplots(2, 1, figsize=(11, 5), sharex=True)\\n\",\n",
    "    \"axes[0].plot(mean_t); axes[0].set_ylabel('mean(frame)'); axes[0].grid(alpha=.3)\\n\",\n",
    "    \"axes[1].plot(std_t);  axes[1].set_ylabel('std(frame)');  axes[1].grid(alpha=.3)\\n\",\n",
    "    \"axes[1].set_xlabel('frame')\\n\",\n",
    "    \"plt.tight_layout(); plt.show()\\n\"\n",
    "   ],\n",
    "   \"id\": \"7e428bed107f789f\",\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"data\": {\n",
    "      \"text/plain\": [\n",
    "       \"<Figure size 1100x500 with 2 Axes>\"\n",
    "      ],\n",
    "      \"image/png\": \"\"\n",
    "     },\n",
    "     \"metadata\": {},\n",
    "     \"output_type\": \"display_data\",\n",
