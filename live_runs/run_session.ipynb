    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"c356470a\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 4. Parameters (native units)\\n\",\n",
    "    \"\\n\",\n",
    "    \"Define the `CNMFeParams` in **native** (full-resolution) units. Section 5\\n\",\n",
    "    \"rescales them to the downsampled grid with `params.downscaled(SSUB, TSUB)`.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"7903ce05\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-05-27T13:44:05.697245241Z\",\n",
    "     \"start_time\": \"2026-05-27T13:44:05.648198214Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"# Parameters in NATIVE (full-resolution) units. When SSUB/TSUB > 1 they are\\n\",\n",
    "    \"# rescaled to the downsampled grid via params.downscaled(SSUB, TSUB) in the\\n\",\n",
    "    \"# next cell, and the rescaled copy drives both MC and extraction.\\n\",\n",
    "    \"params = CNMFeParams(\\n\",\n",
    "    \"    # --- motion correction ---\\n\",\n",
    "    \"    max_shift=(20, 20),\\n\",\n",
    "    \"    upsample_factor=10,\\n\",\n",
    "    \"    mc_n_iter=1,                   # fused AVI->MC path supports 1 only\\n\",\n",
    "    \"    mc_gSig_filt=7,                # 1p high-pass sigma; set None for 2p\\n\",\n",
    "    \"    mc_batch_size=1000,\\n\",\n",
    "    \"    mc_template_max_frames=2000,\\n\",\n",
    "    \"    mc_output_chunk_t=None,        # default = mc_batch_size\\n\",\n",
    "    \"    mc_output_dtype='float32',\\n\",\n",
    "    \"    # --- CNMFe extraction ---\\n\",\n",
    "    \"    sigma=5.0,\\n\",\n",
    "    \"    min_corr=0.8,\\n\",\n",
    "    \"    min_pnr=10.0,\\n\",\n",
    "    \"    n_iter_main=1,\\n\",\n",
    "    \"    n_iter_temporal=2,\\n\",\n",
    "    \"    merge_thr_corr=0.85,\\n\",\n",
    "    \"    merge_thr_overlap=0.5,\\n\",\n",
    "    \"    spatial_max_thr=0.1,\\n\",\n",
    "    \"    n_jobs=-1,\\n\",\n",
    "    \"    decay_time_ms=180,\\n\",\n",
    "    \"    frame_rate_hz=20,\\n\",\n",
    "    \"    g_prior_weight=0.95,\\n\",\n",
    "    \"    global_ar=False,\\n\",\n",
    "    \"    spatial_max_iter = 4000,\\n\",\n",
    "    \"    global_bg_rank=1,\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# CNMFeParams.spatial_max_iter\\n\",\n",
    "    \"print(f'native params: sigma={params.sigma} max_shift={params.max_shift} '\\n\",\n",
    "    \"      f'mc_gSig_filt={params.mc_gSig_filt}')\"\n",
    "   ],\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"native params: sigma=5.0 max_shift=(20, 20) mc_gSig_filt=7\\n\"\n",
    "     ]\n",
    "    }\n",
    "   ],\n",
    "   \"execution_count\": 6\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"cab02274\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 5. Motion correction — fused AVI → `mc.zarr` (+ optional downsample)\\n\",\n",
    "    \"\\n\",\n",
    "    \"`fit_mc_from_avis` decodes the AVIs, bins them **inline** when `SSUB`/`TSUB` > 1,\\n\",\n",
    "    \"and rigid-motion-corrects in one streaming pass — writing only `mc.zarr`\\n\",\n",
    "    \"(float32) + `shifts.npy`. No intermediate `session.zarr` / `ds.zarr`. Peak RAM\\n\",\n",
    "    \"≈ `(mc_batch_size + mc_template_max_frames) * H_out * W_out * 4` bytes,\\n\",\n",
    "    \"independent of T.\\n\",\n",
    "    \"\\n\",\n",
    "    \"`params_eff = params.downscaled(SSUB, TSUB)` rescales `max_shift` /\\n\",\n",
    "    \"`mc_gSig_filt` (and `sigma`, `min_pixel`, ...) to the binned grid; the same\\n\",\n",
    "    \"`params_eff` drives extraction. **`mc_n_iter` must be 1** on the fused path\\n\",\n",
    "    \"(multi-iteration MC needs the two-step `concat_avis_to_zarr` + `fit_mc` flow).\\n\",\n",
    "    \"Idempotent via `skip_if_exists` — delete `mc.zarr` to re-run.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"146ee397\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-05-27T13:44:05.751299516Z\",\n",
    "     \"start_time\": \"2026-05-27T13:44:05.703668395Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"# Rescale native params -> the (possibly downsampled) grid; the same\\n\",\n",
    "    \"# params_eff drives both MC and extraction.\\n\",\n",
    "    \"params_eff = params.downscaled(SSUB, TSUB)\\n\",\n",
    "    \"if DOWNSAMPLE:\\n\",\n",
    "    \"    print(f'downsampling ssub={SSUB} tsub={TSUB}:  '\\n\",\n",
    "    \"          f'sigma {params.sigma}->{params_eff.sigma},  '\\n\",\n",
    "    \"          f'min_pixel {params.min_pixel}->{params_eff.min_pixel},  '\\n\",\n",
    "    \"          f'max_shift {params.max_shift}->{params_eff.max_shift},  '\\n\",\n",
    "    \"          f'mc_gSig_filt {params.mc_gSig_filt}->{params_eff.mc_gSig_filt}')\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Fused decode (+ inline bin) + MC -> mc.zarr (the only zarr written).\\n\",\n",
    "    \"model_mc = CNMFe(params_eff)\\n\",\n",
    "    \"t0 = time.time()\\n\",\n",
    "    \"mc = model_mc.fit_mc_from_avis(\\n\",\n",
    "    \"    RAW_AVI_DIR, output_dir=SESSION_PREPROC,\\n\",\n",
    "    \"    ssub=SSUB, tsub=TSUB, skip_if_exists=True,\\n\",\n",
    "    \")\\n\",\n",
    "    \"print(f'\\\\nfused decode+MC elapsed: {time.time() - t0:.1f}s')\\n\",\n",
    "    \"\\n\",\n",
    "    \"T_mc, H, W = mc.shape\\n\",\n",
    "    \"print(f'mc shape  : {mc.shape}')\\n\",\n",
    "    \"print(f'mc chunks : {mc.chunks}')\\n\",\n",
    "    \"print(f'mc dtype  : {mc.dtype}')\\n\",\n",
    "    \"print(f'shifts    : {None if model_mc.shifts is None else model_mc.shifts.shape}')\"\n",
    "   ],\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"downsampling ssub=2 tsub=2:  sigma 5.0->2.5,  min_pixel 3->1,  max_shift (20, 20)->(10, 10),  mc_gSig_filt 7->3.5\\n\",\n",
    "      \"Output already exists, reusing: /media/server/archive/projects/2023_intercontext/ToneComparison/data/1_preprocessed/20260520_m0000163_som_1317/miniscope_video/mc.zarr\\n\",\n",
    "      \"\\n\",\n",
    "      \"fused decode+MC elapsed: 0.0s\\n\",\n",
    "      \"mc shape  : (40390, 300, 300)\\n\",\n",
    "      \"mc chunks : (1000, 300, 300)\\n\",\n",
    "      \"mc dtype  : float32\\n\",\n",
    "      \"shifts    : (40390, 2)\\n\"\n",
    "     ]\n",
    "    }\n",
    "   ],\n",
    "   \"execution_count\": 7\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"529d1ef5\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 6. MC diagnostics\\n\",\n",
    "    \"\\n\",\n",
    "    \"Three plots, all written to `MC_PLOTS/`:\\n\",\n",
    "    \"\\n\",\n",
    "    \"- **shifts.png** — per-frame `(dy, dx)` over time. Flat-top saturation means\\n\",\n",
    "    \"  shifts are hitting `max_shift` — bump `params.max_shift`.\\n\",\n",
    "    \"- **mean_before_after.png** — raw mean (strided AVI sample, section 3b) vs the\\n\",\n",
    "    \"  corrected mean (streamed over `mc.zarr`). Note: when downsampling, the raw\\n\",\n",
    "    \"  sample is at native resolution and `mc.zarr` is at the downsampled grid, so\\n\",\n",
    "    \"  the two panels differ in pixel size — compare structure, not scale.\\n\",\n",
    "    \"- **template_before_after.png** — same idea, median-based (robust to bursts).\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"cb3a1f3e\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-05-27T13:44:06.012736097Z\",\n",
    "     \"start_time\": \"2026-05-27T13:44:05.761024077Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"if model_mc.shifts is not None:\\n\",\n",
    "    \"    shifts = np.asarray(model_mc.shifts)\\n\",\n",
    "    \"    fig, ax = plt.subplots(2, 1, figsize=(11, 5), sharex=True)\\n\",\n",
    "    \"    ax[0].plot(shifts[:, 0], lw=0.7)\\n\",\n",
    "    \"    ax[0].set_ylabel('dy (px)')\\n\",\n",
    "    \"    ax[0].axhline(0, color='k', lw=0.4)\\n\",\n",
    "    \"    ax[0].grid(alpha=0.3)\\n\",\n",
    "    \"    ax[1].plot(shifts[:, 1], lw=0.7, color='C1')\\n\",\n",
    "    \"    ax[1].set_ylabel('dx (px)')\\n\",\n",
    "    \"    ax[1].set_xlabel('frame')\\n\",\n",
    "    \"    ax[1].axhline(0, color='k', lw=0.4)\\n\",\n",
    "    \"    ax[1].grid(alpha=0.3)\\n\",\n",
    "    \"    fig.suptitle(f'Motion correction shifts  (peak |dy|={np.abs(shifts[:,0]).max():.2f}, '\\n\",\n",
    "    \"                 f'peak |dx|={np.abs(shifts[:,1]).max():.2f})')\\n\",\n",
    "    \"    plt.tight_layout()\\n\",\n",
    "    \"    out = MC_PLOTS / 'shifts.png'\\n\",\n",
    "    \"    fig.savefig(out, dpi=120)\\n\",\n",
    "    \"    plt.show()\\n\",\n",
    "    \"    print(f'wrote {out}')\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    print('no shifts available; skipping plot')\"\n",
    "   ],\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"data\": {\n",
    "      \"text/plain\": [\n",
    "       \"<Figure size 1100x500 with 2 Axes>\"\n",
    "      ],\n",
    "      \"image/png\": \"\"\n",
    "     },\n",
    "     \"metadata\": {},\n",
    "     \"output_type\": \"display_data\",\n",
    "     \"jetTransient\": {\n",
    "      \"display_id\": null\n",
    "     }\n",
    "    },\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"wrote /media/server/archive/projects/2023_intercontext/ToneComparison/data/2_processed/20260520_m0000163_som_1317/miniscope_video/mc_plots/shifts.png\\n\"\n",
    "     ]\n",
    "    }\n",
    "   ],\n",
    "   \"execution_count\": 8\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"07cdc9eb\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-05-27T13:45:41.373605859Z\",\n",
    "     \"start_time\": \"2026-05-27T13:44:06.015652917Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": \"# Corrected mean projection — streamed over the mc.zarr.\\ndef mean_projection(zarr_arr, batch_size: int = 500) -> np.ndarray:\\n    \\\"\\\"\\\"Streamed mean projection; RAM ~ batch_size * H * W * 8 bytes.\\\"\\\"\\\"\\n    T = zarr_arr.shape[0]\\n    acc = np.zeros(zarr_arr.shape[1:], dtype=np.float64)\\n    for start in range(0, T, batch_size):\\n        end = min(start + batch_size, T)\\n        acc += np.asarray(zarr_arr[start:end], dtype=np.float64).sum(axis=0)\\n    return (acc / T).astype(np.float32)\\n\\nmc_mean = mean_projection(mc)\\n\\nfig, axes = plt.subplots(1, 2, figsize=(10, 5))\\naxes[0].imshow(raw_mean, cmap='gray')\\naxes[0].set_title('mean (raw, strided AVI sample)')\\naxes[0].axis('off')\\naxes[1].imshow(mc_mean, cmap='gray')\\naxes[1].set_title('mean (motion-corrected, full)')\\naxes[1].axis('off')\\nplt.tight_layout()\\nout = MC_PLOTS / 'mean_before_after.png'\\nfig.savefig(out, dpi=120)\\nplt.show()\\nprint(f'wrote {out}')\",\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"data\": {\n",
    "      \"text/plain\": [\n",
    "       \"<Figure size 1000x500 with 2 Axes>\"\n",
    "      ],\n",
    "      \"image/png\": \"\"\n",
    "     },\n",
    "     \"metadata\": {},\n",
    "     \"output_type\": \"display_data\",\n",
    "     \"jetTransient\": {\n",
    "      \"display_id\": null\n",
    "     }\n",
    "    },\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"wrote /media/server/archive/projects/2023_intercontext/ToneComparison/data/2_processed/20260520_m0000163_som_1317/miniscope_video/mc_plots/mean_before_after.png\\n\"\n",
    "     ]\n",
    "    }\n",
    "   ],\n",
    "   \"execution_count\": 9\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"99593da0\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-05-27T13:45:41.468442357Z\",\n",
    "     \"start_time\": \"2026-05-27T13:45:41.421528238Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"# # Corrected median template — strided sample of mc.zarr.\\n\",\n",
    "    \"# def strided_median(zarr_arr, max_frames: int = 800) -> np.ndarray:\\n\",\n",
    "    \"#     \\\"\\\"\\\"Median projection from a strided sample — robust to bright transients.\\\"\\\"\\\"\\n\",\n",
    "    \"#     T = zarr_arr.shape[0]\\n\",\n",
    "    \"#     idx = np.linspace(0, T - 1, min(T, max_frames)).astype(int)\\n\",\n",
    "    \"#     sample = np.stack([np.asarray(zarr_arr[i]) for i in idx], axis=0)\\n\",\n",
    "    \"#     return np.median(sample.astype(np.float32), axis=0)\\n\",\n",
    "    \"#\\n\",\n",
    "    \"# mc_tmpl = strided_median(mc)\\n\",\n",
    "    \"#\\n\",\n",
    "    \"# fig, axes = plt.subplots(1, 2, figsize=(10, 5))\\n\",\n",
    "    \"# axes[0].imshow(raw_tmpl, cmap='gray')\\n\",\n",
    "    \"# axes[0].set_title('median template (raw, strided AVI sample)')\\n\",\n",
    "    \"# axes[0].axis('off')\\n\",\n",
    "    \"# axes[1].imshow(mc_tmpl, cmap='gray')\\n\",\n",
    "    \"# axes[1].set_title('median template (motion-corrected, full)')\\n\",\n",
    "    \"# axes[1].axis('off')\\n\",\n",
    "    \"# plt.tight_layout()\\n\",\n",
    "    \"# out = MC_PLOTS / 'template_before_after.png'\\n\",\n",
    "    \"# fig.savefig(out, dpi=120)\\n\",\n",
    "    \"# plt.show()\\n\",\n",
    "    \"# print(f'wrote {out}')\"\n",
    "   ],\n",
