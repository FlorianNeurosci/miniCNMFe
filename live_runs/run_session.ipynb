    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-05-27T13:47:29.489619425Z\",\n",
    "     \"start_time\": \"2026-05-27T13:47:28.924381488Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"mad = np.median(np.abs(mean_t - np.median(mean_t)))\\n\",\n",
    "    \"flash_thr = np.median(mean_t) + 5 * 1.4826 * mad\\n\",\n",
    "    \"flash_idx = np.where(mean_t > flash_thr)[0]\\n\",\n",
    "    \"print(f'{len(flash_idx)} flash frames (e.g. {flash_idx[:8]})')\\n\",\n",
    "    \"\\n\",\n",
    "    \"t_flash = int(flash_idx[np.argmax(mean_t[flash_idx])])\\n\",\n",
    "    \"near = np.arange(max(0, t_flash - 30), min(len(mean_t), t_flash + 30))\\n\",\n",
    "    \"near = near[~np.isin(near, flash_idx)]\\n\",\n",
    "    \"t_quiet = int(near[np.argmin(mean_t[near])])\\n\",\n",
    "    \"\\n\",\n",
    "    \"flash = arr[t_flash].astype(np.float32)\\n\",\n",
    "    \"quiet = arr[t_quiet].astype(np.float32)\\n\",\n",
    "    \"diff  = flash - quiet\\n\",\n",
    "    \"\\n\",\n",
    "    \"_, S, _ = np.linalg.svd(diff, full_matrices=False)\\n\",\n",
    "    \"rank1_frac = float(S[0]**2 / (S**2).sum())\\n\",\n",
    "    \"\\n\",\n",
    "    \"vmax = float(np.abs(diff).max())\\n\",\n",
    "    \"fig, axes = plt.subplots(1, 3, figsize=(13, 4))\\n\",\n",
    "    \"axes[0].imshow(flash, cmap='gray'); axes[0].set_title(f'flash t={t_flash}'); axes[0].axis('off')\\n\",\n",
    "    \"axes[1].imshow(quiet, cmap='gray'); axes[1].set_title(f'quiet t={t_quiet}'); axes[1].axis('off')\\n\",\n",
    "    \"axes[2].imshow(diff, cmap='seismic', vmin=-vmax, vmax=vmax)\\n\",\n",
    "    \"axes[2].set_title(f'diff — rank-1 explains {100*rank1_frac:.1f}%')\\n\",\n",
    "    \"axes[2].axis('off')\\n\",\n",
    "    \"plt.tight_layout(); plt.show()\"\n",
    "   ],\n",
