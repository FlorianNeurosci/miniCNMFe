    "      \"Skipping reject; /media/server/archive/projects/2023_intercontext/ToneComparison/data/1_preprocessed/20260520_m0000163_som_1317/miniscope_video/mc_clean.zarr already exists.\\n\",\n",
    "      \"reject wall time: 0.0s (936 frames replaced)\\n\",\n",
    "      \"outlier frames -> /media/server/archive/projects/2023_intercontext/ToneComparison/data/2_processed/20260520_m0000163_som_1317/miniscope_video/results/outlier_frames.npy  (936 indices)\\n\",\n",
    "      \"clean input -> /media/server/archive/projects/2023_intercontext/ToneComparison/data/1_preprocessed/20260520_m0000163_som_1317/miniscope_video/mc_clean.zarr  shape=(40390, 300, 300)\\n\"\n",
    "     ]\n",
