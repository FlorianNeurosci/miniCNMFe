    "    \"    model.evaluate()                           # non-destructive component tagging\\n\",\n",
    "    \"    elapsed = time.time() - t0\\n\",\n",
    "    \"    print(f'\\\\nextracted {model.A.shape[1]} components in {elapsed:.1f}s')\\n\",\n",
    "    \"\\n\",\n",
    "    \"    model.save(RESULTS_DIR)\\n\",\n",
    "    \"    (RESULTS_DIR / 'run_info.json').write_text(json.dumps({\\n\",\n",
    "    \"        'session_raw'        : str(SESSION_RAW),\\n\",\n",
    "    \"        'mc_zarr'            : str(MC_ZARR),\\n\",\n",
