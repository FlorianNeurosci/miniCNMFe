    "     \"start_time\": \"2026-05-27T13:47:23.350332131Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": \"arr.shape\",\n",
    "   \"id\": \"125392e6a89e00f\",\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"data\": {\n",
    "      \"text/plain\": [\n",
    "       \"(40390, 300, 300)\"\n",
