    "   \"source\": [\n",
    "    \"## Output summary\\n\",\n",
    "    \"\\n\",\n",
    "    \"All artifacts for this session:\\n\",\n",
    "    \"\\n\",\n",
    "    \"```\\n\",\n",
    "    \"1_preprocessed/<session>/miniscope_video/\\n\",\n",
