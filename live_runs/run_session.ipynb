    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 2. Session paths + downsample factors\\n\",\n",
    "    \"\\n\",\n",
    "    \"Set `SESSION_RAW` to the raw `miniscope_video` folder; `1_preprocessed` and\\n\",\n",
    "    \"`2_processed` are derived by replacing the `0_raw` segment. `SSUB` / `TSUB` are\\n\",\n",
    "    \"the spatial / temporal bin factors (1 = no downsampling).\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"2c61e3f4\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-05-27T13:43:32.583967943Z\",\n",
    "     \"start_time\": \"2026-05-27T13:43:32.516687240Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"# --- EDIT ME -----------------------------------------------------------------\\n\",\n",
    "    \"SESSION_RAW = Path(\\n\",\n",
    "    \"    '/media/server/archive/projects/2023_intercontext/ToneComparison/'\\n\",\n",
    "    \"    'data/0_raw/20260520_m0000163_som_1317/miniscope_video'\\n\",\n",
    "    \")\\n\",\n",
    "    \"SSUB = 2    # spatial bin factor  (1 = no spatial downsampling)\\n\",\n",
    "    \"TSUB = 2    # temporal bin factor (1 = no temporal downsampling)\\n\",\n",
    "    \"# -----------------------------------------------------------------------------\\n\",\n",
    "    \"\\n\",\n",
    "    \"def _swap_stage(p: Path, new_stage: str) -> Path:\\n\",\n",
    "    \"    # Replace the '0_raw' segment with `new_stage` in a path.\\n\",\n",
    "    \"    parts = list(p.parts)\\n\",\n",
    "    \"    try:\\n\",\n",
    "    \"        i = parts.index('0_raw')\\n\",\n",
    "    \"    except ValueError as exc:\\n\",\n",
    "    \"        raise ValueError(\\n\",\n",
    "    \"            f\\\"Expected '0_raw' in path {p}; can't derive {new_stage} location.\\\"\\n\",\n",
    "    \"        ) from exc\\n\",\n",
    "    \"    parts[i] = new_stage\\n\",\n",
    "    \"    return Path(*parts)\\n\",\n",
    "    \"\\n\",\n",
    "    \"SESSION_PREPROC = _swap_stage(SESSION_RAW, '1_preprocessed')\\n\",\n",
    "    \"SESSION_PROC    = _swap_stage(SESSION_RAW, '2_processed')\\n\",\n",
    "    \"\\n\",\n",
    "    \"DOWNSAMPLE  = (SSUB > 1 or TSUB > 1)\\n\",\n",
    "    \"RAW_AVI_DIR = SESSION_RAW\\n\",\n",
    "    \"MC_ZARR     = SESSION_PREPROC / 'mc.zarr'      # the only zarr written (fused)\\n\",\n",
    "    \"SHIFTS_NPY  = SESSION_PREPROC / 'shifts.npy'\\n\",\n",
    "    \"MC_PLOTS    = SESSION_PROC / 'mc_plots'\\n\",\n",
    "    \"MC_MP4      = SESSION_PROC / 'mc_downsampled.mp4'\\n\",\n",
    "    \"RESULTS_DIR = SESSION_PROC / 'results'\\n\",\n",
    "    \"\\n\",\n",
    "    \"SESSION_PREPROC.mkdir(parents=True, exist_ok=True)\\n\",\n",
    "    \"SESSION_PROC.mkdir(parents=True, exist_ok=True)\\n\",\n",
    "    \"MC_PLOTS.mkdir(parents=True, exist_ok=True)\\n\",\n",
    "    \"RESULTS_DIR.mkdir(parents=True, exist_ok=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print('Raw AVIs  :', RAW_AVI_DIR)\\n\",\n",
    "    \"print(f'Downsample : ssub={SSUB} tsub={TSUB}  ({\\\"on\\\" if DOWNSAMPLE else \\\"off\\\"})')\\n\",\n",
    "    \"print('MC zarr  ->', MC_ZARR)\\n\",\n",
    "    \"print('Shifts   ->', SHIFTS_NPY)\\n\",\n",
    "    \"print('MC plots ->', MC_PLOTS)\\n\",\n",
    "    \"print('MC mp4   ->', MC_MP4)\\n\",\n",
    "    \"print('Results  ->', RESULTS_DIR)\\n\",\n",
    "    \"\\n\",\n",
    "    \"assert RAW_AVI_DIR.is_dir(), f'Raw folder does not exist: {RAW_AVI_DIR}'\"\n",
    "   ],\n",
