    "   \"execution_count\": 10\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"f46ea3f2\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 7. Downsampled MC video for visual QC\\n\",\n",
    "    \"\\n\",\n",
    "    \"Every Nth frame of the corrected zarr written as a small mp4, intensity\\n\",\n",
    "    \"normalised to the 0.5–99.5 percentile range. Idempotent: skips if the mp4\\n\",\n",
    "    \"already exists.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"84e0b91c\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-05-27T13:45:41.521179412Z\",\n",
    "     \"start_time\": \"2026-05-27T13:45:41.469741595Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": \"STRIDE  = 20        # save every Nth frame\\nFPS_OUT = 50.0      # playback speed of the produced mp4\\n\\nif MC_MP4.exists():\\n    print(f'{MC_MP4} already exists, skipping (delete to re-render)')\\nelse:\\n    chunk_t = mc.chunks[0]\\n    n_chunks = (T_mc + chunk_t - 1) // chunk_t\\n    n_out_frames = (T_mc + STRIDE - 1) // STRIDE\\n    print(f'rendering every {STRIDE}th of {T_mc} frames '\\n          f'({n_out_frames} out; {n_chunks} chunk reads of chunk_t={chunk_t})...')\\n\\n    # Display range — sample three chunk-aligned slabs at start / mid / end so\\n    # we touch 3 chunks instead of 200 individual frame reads (each random\\n    # read decompresses a full chunk).\\n    starts = (\\n        0,\\n        max(0, ((T_mc // 2) // chunk_t) * chunk_t),\\n        max(0, T_mc - chunk_t),\\n    )\\n    sample = np.concatenate(\\n        [np.asarray(mc[s : min(s + chunk_t, T_mc)]) for s in starts], axis=0\\n    )\\n    lo = float(np.percentile(sample, 0.5))\\n    hi = float(np.percentile(sample, 99.5))\\n    print(f'display range: [{lo:.2f}, {hi:.2f}]  (sampled {sample.shape[0]} frames)')\\n\\n    import cv2\\n    fourcc = cv2.VideoWriter_fourcc(*'mp4v')\\n    H_mc, W_mc = mc.shape[1], mc.shape[2]\\n    writer = cv2.VideoWriter(str(MC_MP4), fourcc, FPS_OUT, (W_mc, H_mc), isColor=False)\\n    if not writer.isOpened():\\n        raise RuntimeError(f'cv2.VideoWriter failed to open {MC_MP4}')\\n\\n    t0 = time.time()\\n    written = 0\\n    try:\\n        # Read chunk-aligned batches (one chunk decompress per read); stride\\n        # within each batch in RAM. Replaces the old per-frame random-access\\n        # loop, which re-decompressed each chunk ~chunk_t/STRIDE times.\\n        for c_start in range(0, T_mc, chunk_t):\\n            c_end = min(c_start + chunk_t, T_mc)\\n            batch = np.asarray(mc[c_start:c_end], dtype=np.float32)\\n            local_offset = (-c_start) % STRIDE  # keep stride globally aligned\\n            for j in range(local_offset, c_end - c_start, STRIDE):\\n                frame = np.clip((batch[j] - lo) / (hi - lo + 1e-8), 0.0, 1.0)\\n                writer.write((frame * 255).astype(np.uint8))\\n                written += 1\\n            print(f'  chunk {c_start // chunk_t + 1}/{n_chunks}: '\\n                  f'wrote {written}/{n_out_frames} frames')\\n    finally:\\n        writer.release()\\n\\n    print(f'\\\\nwrote {MC_MP4}  ({time.time() - t0:.1f}s, {written} frames)')\",\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"/media/server/archive/projects/2023_intercontext/ToneComparison/data/2_processed/20260520_m0000163_som_1317/miniscope_video/mc_downsampled.mp4 already exists, skipping (delete to re-render)\\n\"\n",
    "     ]\n",
    "    }\n",
    "   ],\n",
    "   \"execution_count\": 11\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"e274a5d4\",\n",
    "   \"source\": \"## 7a. Outlier-frame rejection (optional preprocessing)\\n\\nDetects frames whose **spatial mean** is a strong MAD outlier (camera\\nsaturation, brief illumination flashes, motion glitches the MC missed) and\\nreplaces them by linear interpolation between the nearest non-outlier frames.\\nUse when the global-mean trace shows isolated few-frame spikes that the\\nrolling-percentile detrend below cannot remove (the window is too wide to flag\\nbrief flashes).\\n\\nRuns in two streaming passes over `mc.zarr` and writes `mc_clean.zarr` next to\\nit (plus a `mc_clean.zarr.outliers.npy` sidecar). Idempotent — delete the zarr\\nto re-run.\\n\\n**When this can hurt.** With `REJECT_K_MAD = 5.0` and Gaussian-shaped per-frame\\nmeans, the false-positive rate is ~0.1 % (≈ a few dozen frames per 40 k). On\\nsparse-activity recordings that is negligible. On recordings with **genuine\\npopulation-wide synchronous bursts**, those bursts also lift the global mean\\nand will be flagged + interpolated — erasing the synchronous event. Mitigate\\nby:\\n\\n- Raising `REJECT_K_MAD` to 7–10 (only the most extreme flashes get caught).\\n- Inspecting `outlier_idx` printed by the cell; if it's clustered on a real\\n  event, raise the threshold or set `REJECT_K_MAD = None` to skip.\\n\\nLeave `REJECT_K_MAD = None` when the mean-luminance trace looks clean.\",\n",
    "   \"metadata\": {}\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"c2050d60\",\n",
    "   \"source\": [\n",
    "    \"# --- EDIT ME -----------------------------------------------------------------\\n\",\n",
    "    \"REJECT_K_MAD = 4      # set to e.g. 5.0 to enable; None = skip outlier rejection\\n\",\n",
    "    \"# -----------------------------------------------------------------------------\\n\",\n",
    "    \"\\n\",\n",
    "    \"MC_CLEAN_ZARR      = SESSION_PREPROC / 'mc_clean.zarr'\\n\",\n",
    "    \"OUTLIER_FRAMES_NPY = RESULTS_DIR / 'outlier_frames.npy'   # for downstream NaN-masking\\n\",\n",
    "    \"\\n\",\n",
    "    \"if REJECT_K_MAD is None:\\n\",\n",
    "    \"    print('reject: SKIPPED (set REJECT_K_MAD to enable)')\\n\",\n",
    "    \"    clean_zarr      = mc\\n\",\n",
    "    \"    clean_zarr_path = MC_ZARR\\n\",\n",
    "    \"    rejected_idx    = np.empty(0, dtype=np.int64)\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    from minicnmfe.reject_frames import reject_outlier_frames\\n\",\n",
    "    \"    t0 = time.time()\\n\",\n",
    "    \"    clean_zarr, rejected_idx = reject_outlier_frames(\\n\",\n",
    "    \"        MC_ZARR, MC_CLEAN_ZARR,\\n\",\n",
    "    \"        k_mad=REJECT_K_MAD,\\n\",\n",
    "    \"        batch_t=params_eff.mc_batch_size,\\n\",\n",
    "    \"        skip_if_exists=True,\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    print(f'reject wall time: {time.time() - t0:.1f}s '\\n\",\n",
    "    \"          f'({len(rejected_idx)} frames replaced)')\\n\",\n",
    "    \"    clean_zarr_path = MC_CLEAN_ZARR\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Persist outlier indices in the *processed* tree so downstream analysis can\\n\",\n",
    "    \"# NaN-mask the corresponding entries of C / S / YrA / C_raw without having to\\n\",\n",
    "    \"# re-read the preprocessed sidecar. Coordinates are on the extraction grid\\n\",\n",
    "    \"# (i.e. already at ssub/tsub), so they index trace columns directly:\\n\",\n",
    "    \"#\\n\",\n",
    "    \"#     outliers = np.load(RESULTS_DIR / 'outlier_frames.npy')\\n\",\n",
    "    \"#     C_masked = model.C.copy()\\n\",\n",
    "    \"#     C_masked[:, outliers] = np.nan\\n\",\n",
    "    \"np.save(OUTLIER_FRAMES_NPY, np.asarray(rejected_idx, dtype=np.int64))\\n\",\n",
    "    \"print(f'outlier frames -> {OUTLIER_FRAMES_NPY}  '\\n\",\n",
    "    \"      f'({len(rejected_idx)} indices)')\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f'clean input -> {clean_zarr_path}  shape={clean_zarr.shape}')\"\n",
    "   ],\n",
