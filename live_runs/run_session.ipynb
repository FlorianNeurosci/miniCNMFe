    "   },\n",
    "   \"source\": \"# Pull a few evenly-spaced frames straight from the AVIs (no zarr).\\n# Reuses the same luma-gray decoder the MC path will use.\\nimport av\\n\\ndef _decode_first_frame(avi_path: Path) -> np.ndarray:\\n    container = av.open(str(avi_path))\\n    try:\\n        stream = container.streams.video[0]\\n        stream.thread_type = 'FRAME'\\n        for frame in container.decode(stream):\\n            return frame.to_ndarray(format='gray8')\\n    finally:\\n        container.close()\\n    raise RuntimeError(f'{avi_path} has no frames')\\n\\nsample_picks = np.linspace(0, len(avis) - 1, 4).astype(int)\\nsample = np.stack([_decode_first_frame(avis[i]) for i in sample_picks], axis=0)\\n\\nfig, axes = plt.subplots(1, 4, figsize=(14, 3.5))\\nfor ax, i, img in zip(axes, sample_picks, sample):\\n    ax.imshow(img, cmap='gray')\\n    ax.set_title(f'{avis[i].name}, frame 0')\\n    ax.axis('off')\\nfig.suptitle('First frame of 4 sampled AVIs (no zarr involved)', y=1.02)\\nplt.tight_layout()\\nplt.show()\",\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"data\": {\n",
    "      \"text/plain\": [\n",
    "       \"<Figure size 1400x350 with 4 Axes>\"\n",
    "      ],\n",
    "      \"image/png\": \"\"\n",
    "     },\n",
    "     \"metadata\": {},\n",
    "     \"output_type\": \"display_data\",\n",
    "     \"jetTransient\": {\n",
    "      \"display_id\": null\n",
    "     }\n",
    "    }\n",
    "   ],\n",
    "   \"execution_count\": 4\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"76afc636\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-05-27T13:44:05.602038433Z\",\n",
    "     \"start_time\": \"2026-05-27T13:43:39.741150064Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"# Coarse raw mean projection: decode every Nth frame from ~12 strided AVIs,\\n\",\n",
    "    \"# average them in RAM. Light enough to run before MC; gives us a \\\"before\\\"\\n\",\n",
    "    \"# baseline for the diagnostic plots later.\\n\",\n",
    "    \"def avi_mean_and_median(avi_paths, max_avis: int = 12, stride_within: int = 50):\\n\",\n",
    "    \"    \\\"\\\"\\\"Decode strided frames from a strided AVI subset; return (mean, median)\\n\",\n",
    "    \"    images.\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    k = min(max_avis, len(avi_paths))\\n\",\n",
    "    \"    picks = np.linspace(0, len(avi_paths) - 1, k).astype(int)\\n\",\n",
    "    \"    pool = []\\n\",\n",
    "    \"    for i in picks:\\n\",\n",
    "    \"        container = av.open(str(avi_paths[i]))\\n\",\n",
    "    \"        try:\\n\",\n",
    "    \"            stream = container.streams.video[0]\\n\",\n",
    "    \"            stream.thread_type = 'FRAME'\\n\",\n",
    "    \"            for j, frame in enumerate(container.decode(stream)):\\n\",\n",
    "    \"                if j % stride_within == 0:\\n\",\n",
    "    \"                    pool.append(frame.to_ndarray(format='gray8'))\\n\",\n",
    "    \"        finally:\\n\",\n",
    "    \"            container.close()\\n\",\n",
    "    \"    sampled = np.stack(pool, axis=0).astype(np.float32)\\n\",\n",
    "    \"    return sampled.mean(axis=0), np.median(sampled, axis=0)\\n\",\n",
    "    \"\\n\",\n",
    "    \"t0 = time.time()\\n\",\n",
    "    \"raw_mean, raw_tmpl = avi_mean_and_median(avis)\\n\",\n",
    "    \"H_raw, W_raw = raw_mean.shape\\n\",\n",
    "    \"print(f'raw inspection sample: {raw_mean.shape}  '\\n\",\n",
    "    \"      f'(decoded {time.time() - t0:.1f}s)')\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, ax = plt.subplots(1, 1, figsize=(5, 5))\\n\",\n",
    "    \"ax.imshow(raw_mean, cmap='gray')\\n\",\n",
