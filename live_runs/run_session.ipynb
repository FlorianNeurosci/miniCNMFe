    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 10. Re-upsample to native resolution (optional)\\n\",\n",
    "    \"\\n\",\n",
    "    \"`model.upsample_to_native(...)` returns a NEW model with footprints (bilinear)\\n\",\n",
    "    \"and continuous traces (linear) interpolated back to the native grid / frame\\n\",\n",
    "    \"rate — for overlaying on a native reference image and plotting against\\n\",\n",
    "    \"native-rate signals. It is **interpolation, not recovery**: the native movie is\\n\",\n",
    "    \"gone in the downsample-once workflow, so no discarded detail comes back. The\\n\",\n",
    "    \"deconvolved spike train `S` stays at the downsampled rate and the background\\n\",\n",
    "    \"model is dropped (this model is for inspection/overlay, not re-fitting).\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"b6dfa56d\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-05-27T14:01:22.556600486Z\",\n",
    "     \"start_time\": \"2026-05-27T14:01:21.110434878Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"# Re-express the downsampled results on the NATIVE grid / frame rate.\\n\",\n",
    "    \"# `raw_mean` (native, section 3b) and `total` (native frame count, section 3a)\\n\",\n",
    "    \"# give the native dims / T.\\n\",\n",
    "    \"model_native = model.upsample_to_native(\\n\",\n",
    "    \"    ssub=SSUB, tsub=TSUB, orig_dims=raw_mean.shape, orig_T=total,\\n\",\n",
    "    \")\\n\",\n",
    "    \"print(f'native  A: {model_native.A.shape}  C: {model_native.C.shape}  '\\n\",\n",
    "    \"      f'dims={model_native.dims}')\\n\",\n",
    "    \"print(f'(downsampled  A: {model.A.shape}  C: {model.C.shape})')\\n\",\n",
    "    \"\\n\",\n",
    "    \"Kn = model_native.A.shape[1]\\n\",\n",
    "    \"A_nat = np.asarray(model_native.A.todense()).reshape(*model_native.dims, Kn)\\n\",\n",
    "    \"acc = getattr(model_native, 'accepted_mask', None)\\n\",\n",
    "    \"if acc is None:\\n\",\n",
    "    \"    acc = np.ones(Kn, dtype=bool)\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, axes = plt.subplots(1, 2, figsize=(13, 6))\\n\",\n",
    "    \"# Left: native-grid footprints over the native raw mean.\\n\",\n",
    "    \"axes[0].imshow(raw_mean, cmap='gray')\\n\",\n",
    "    \"for k in range(Kn):\\n\",\n",
    "    \"    fp = A_nat[..., k]\\n\",\n",
    "    \"    if fp.max() <= 0:\\n\",\n",
    "    \"        continue\\n\",\n",
    "    \"    axes[0].contour(fp, levels=[fp.max() * 0.3],\\n\",\n",
    "    \"                    colors='red' if acc[k] else '0.6', linewidths=0.7)\\n\",\n",
    "    \"axes[0].set_title(f'native-grid footprints '\\n\",\n",
    "    \"                  f'({model_native.dims[0]}x{model_native.dims[1]}, '\\n\",\n",
    "    \"                  f'{int(acc.sum())}/{Kn} accepted)')\\n\",\n",
    "    \"axes[0].axis('off')\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Right: a few native-rate projected traces (C + YrA at the native frame count).\\n\",\n",
    "    \"proj = model_native.C + model_native.YrA          # (K, native_T)\\n\",\n",
    "    \"order = np.argsort(-proj.max(axis=1))[:min(6, Kn)]\\n\",\n",
    "    \"step = float(proj.max()) * 0.6 if Kn else 1.0\\n\",\n",
    "    \"for j, k in enumerate(order):\\n\",\n",
    "    \"    axes[1].plot(proj[k] + j * step, lw=0.6)\\n\",\n",
    "    \"axes[1].set_title(f'native-rate C + YrA  (T={proj.shape[1]})')\\n\",\n",
    "    \"axes[1].set_xlabel('frame (native rate)')\\n\",\n",
    "    \"axes[1].set_yticks([])\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"out = MC_PLOTS / 'native_footprints_traces.png'\\n\",\n",
    "    \"fig.savefig(out, dpi=120)\\n\",\n",
    "    \"plt.show()\\n\",\n",
    "    \"print(f'wrote {out}')\"\n",
    "   ],\n",
