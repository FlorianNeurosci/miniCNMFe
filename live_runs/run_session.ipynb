    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"arr = np.array(extract_zarr)\\n\",\n",
    "    \"# arr = np.array(clean_zarr)\"\n",
