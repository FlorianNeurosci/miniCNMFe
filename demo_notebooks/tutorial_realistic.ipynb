    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"c12\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"---\\n\",\n",
    "    \"## 4. CORR and PNR summary images\\n\",\n",
    "    \"\\n\",\n",
    "    \"The CORR × PNR map should highlight **true** neurons (white +), but ghost cells in the background also produce locally correlated, locally bright patches — they show up as spurious bright spots on the seed-score image. This is the canonical 1p false-positive: the algorithm cannot tell from the summary image alone which patches are real cells.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"c13\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-05-27T15:09:14.842725034Z\",\n",
    "     \"start_time\": \"2026-05-27T15:09:10.082102864Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"from cnmfe.preprocess import correlation_pnr, make_center_surround_psf\\n\",\n",
    "    \"\\n\",\n",
    "    \"sigma = 5.0  # neuron radius from the simulator (~8 px footprint radius)\\n\",\n",
    "    \"cn, pnr = correlation_pnr(mc_movie, sigma=sigma, center_psf=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, axes = plt.subplots(1, 3, figsize=(13, 4))\\n\",\n",
    "    \"axes[0].imshow(cn,  cmap='inferno', vmin=0, vmax=1)\\n\",\n",
    "    \"axes[1].imshow(pnr, cmap='inferno')\\n\",\n",
    "    \"axes[2].imshow(cn * pnr, cmap='inferno')\\n\",\n",
    "    \"for ax, title in zip(axes, ['CORR', 'PNR', 'CORR x PNR (seed score)']):\\n\",\n",
    "    \"    for r, c in centers:\\n\",\n",
    "    \"        ax.plot(c, r, 'w+', ms=10, mew=2)\\n\",\n",
    "    \"    ax.set_title(title); ax.axis('off')\\n\",\n",
    "    \"plt.suptitle('+ marks = true neurons. CORR is high almost everywhere - the active neuropil '\\n\",\n",
    "    \"             'correlates neighbouring pixels; PNR separates the real cells.', fontsize=9)\\n\",\n",
    "    \"plt.tight_layout(); plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f'CORR p50/p90 = {np.nanpercentile(cn, 50):.2f}/{np.nanpercentile(cn, 90):.2f}   '\\n\",\n",
    "    \"      f'PNR p50/p90/max = {np.nanpercentile(pnr, 50):.1f}/{np.nanpercentile(pnr, 90):.1f}/'\\n\",\n",
    "    \"      f'{np.nanpercentile(pnr, 100):.1f}')\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"c14\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"---\\n\",\n",
    "    \"## 5. Ring-model background\\n\",\n",
    "    \"\\n\",\n",
    "    \"For each pixel, predict its background from a weighted ring of neighbours (radius ≈ neuron diameter). After fitting the weights via per-pixel ridge regression, we subtract `b0 + W @ (Y - b0)` from the data — leaving the residual that the rest of the pipeline operates on.\\n\",\n",
    "    \"\\n\",\n",
    "    \"We fit `W` here with the **true** A and C so we can isolate how well the ring model itself attacks the multi-component drifting background and ghost cells in this realistic movie.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"c15\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-05-27T15:09:22.675547340Z\",\n",
    "     \"start_time\": \"2026-05-27T15:09:19.940264554Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"from cnmfe.background import compute_W, subtract_background, build_ring_indices\\n\",\n",
    "    \"from cnmfe._utils import make_2d\\n\",\n",
    "    \"\\n\",\n",
    "    \"ring_radius = 1.5 * (2 * sigma + 1)\\n\",\n",
    "    \"A_sp = sp.csc_matrix(A_true.astype(np.float32))\\n\",\n",
    "    \"Y_flat = make_2d(mc_movie)\\n\",\n",
    "    \"\\n\",\n",
    "    \"W_mat, b0 = compute_W(Y_flat, A_sp, C_true, (H, W), ring_radius, lambda_reg=1e-5)\\n\",\n",
    "    \"Y_bg = subtract_background(Y_flat, W_mat, b0)\\n\",\n",
    "    \"print(f'W shape: {W_mat.shape}, nnz: {W_mat.nnz} ({W_mat.nnz / W_mat.shape[0]:.1f} per row)')\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Pick a background pixel (no neuron there) and a neuron-centre pixel\\n\",\n",
    "    \"bg_row, bg_col = H // 6, W // 6\\n\",\n",
    "    \"bg_px = bg_row * W + bg_col\\n\",\n",
    "    \"nr, nc = centers[0]\\n\",\n",
    "    \"nr_px = nr * W + nc\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, axes = plt.subplots(2, 1, figsize=(11, 4), sharex=True)\\n\",\n",
    "    \"axes[0].plot(Y_flat[bg_px], lw=0.7, alpha=0.8, label='Raw')\\n\",\n",
    "    \"axes[0].plot(Y_bg[bg_px],   lw=0.7, alpha=0.8, label='After ring subtraction')\\n\",\n",
    "    \"axes[0].set_ylabel(f'BG pixel ({bg_row},{bg_col})\\\\nstd: {Y_flat[bg_px].std():.2f} -> {Y_bg[bg_px].std():.2f}', fontsize=8)\\n\",\n",
    "    \"axes[0].legend(fontsize=8)\\n\",\n",
    "    \"\\n\",\n",
    "    \"axes[1].plot(Y_flat[nr_px], lw=0.7, alpha=0.8, label='Raw')\\n\",\n",
    "    \"axes[1].plot(Y_bg[nr_px],   lw=0.7, alpha=0.8, label='After ring subtraction')\\n\",\n",
    "    \"axes[1].set_ylabel(f'Neuron pixel ({nr},{nc})\\\\nstd: {Y_flat[nr_px].std():.2f} -> {Y_bg[nr_px].std():.2f}', fontsize=8)\\n\",\n",
    "    \"axes[1].set_xlabel('Frame'); axes[1].legend(fontsize=8)\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.suptitle('Ring model strips drifting background; neuron transients survive', fontsize=10)\\n\",\n",
    "    \"plt.tight_layout(); plt.show()\"\n",
    "   ],\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"W shape: (16384, 16384), nnz: 1266588 (77.3 per row)\\n\"\n",
    "     ]\n",
    "    },\n",
    "    {\n",
    "     \"data\": {\n",
    "      \"text/plain\": [\n",
    "       \"<Figure size 1320x480 with 2 Axes>\"\n",
    "      ],\n",
    "      \"image/png\": \"\"\n",
    "     },\n",
    "     \"metadata\": {},\n",
    "     \"output_type\": \"display_data\",\n",
    "     \"jetTransient\": {\n",
    "      \"display_id\": null\n",
    "     }\n",
    "    }\n",
    "   ],\n",
    "   \"execution_count\": 10\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"c16\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"---\\n\",\n",
    "    \"## 6. Greedy initialization\\n\",\n",
    "    \"\\n\",\n",
    "    \"`greedy_corr_pnr` finds neurons one at a time, brightest first. Each iteration it picks the highest CORR×PNR pixel, fits a footprint and trace, subtracts that contribution from the data, recomputes CORR/PNR locally, and zeroes a disk of radius ~2σ around every found centre so the residual halo can't reseed the same neuron.\\n\",\n",
    "    \"\\n\",\n",
    "    \"On this messy movie the loose-default thresholds will pick up many ghost-cell patches in addition to real neurons. We explicitly use a tighter `min_pnr` here than on the clean tutorial.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"c17\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-05-27T15:09:34.085995594Z\",\n",
    "     \"start_time\": \"2026-05-27T15:09:25.859287964Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"from cnmfe.initialization import greedy_corr_pnr\\n\",\n",
    "    \"\\n\",\n",
    "    \"A_init, C_init, C_raw_init, centers_init = greedy_corr_pnr(\\n\",\n",
    "    \"    mc_movie, sigma=sigma, min_corr=0.90, min_pnr=7.0, ar_order=1, border_px=5\\n\",\n",
    "    \")\\n\",\n",
    "    \"K_init = A_init.shape[1]\\n\",\n",
    "    \"print(f'Initialized {K_init} components (truth = {K})')\\n\",\n",
    "    \"\\n\",\n",
    "    \"A_init_dense = np.asarray(A_init.todense()).reshape(H, W, K_init)\\n\",\n",
    "    \"fig, axes = plt.subplots(1, 2, figsize=(11, 4))\\n\",\n",
    "    \"axes[0].imshow(A_init_dense.max(axis=2), cmap='hot')\\n\",\n",
    "    \"for r, c in centers_init: axes[0].plot(c, r, 'b+', ms=8, mew=1.5)\\n\",\n",
    "    \"for r, c in centers:        axes[0].plot(c, r, 'w+', ms=10, mew=2)\\n\",\n",
    "    \"axes[0].set_title(f'Initialized footprints (n={K_init})\\\\nblue = detected, white = true')\\n\",\n",
    "    \"axes[0].axis('off')\\n\",\n",
    "    \"\\n\",\n",
    "    \"for k in range(min(4, K_init)):\\n\",\n",
    "    \"    axes[1].plot(C_init[k] / (C_init[k].max() + 1e-10) + k, lw=0.8, label=f'comp {k+1}')\\n\",\n",
    "    \"axes[1].set_xlabel('Frame'); axes[1].set_title('Initialized traces')\\n\",\n",
    "    \"axes[1].legend(fontsize=8)\\n\",\n",
    "    \"plt.tight_layout(); plt.show()\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"c18\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"---\\n\",\n",
    "    \"## 7. Refinement — AR(1) + OASIS\\n\",\n",
    "    \"\\n\",\n",
    "    \"Each component's trace is iteratively refined by block coordinate descent: project the residual onto the footprint, deconvolve with OASIS to enforce AR(1), update.\\n\",\n",
    "    \"\\n\",\n",
    "    \"Here all neurons share an indicator (GCaMP8m), so `g_true` is concentrated near ~0.76 (≈0.73–0.78 at 20 fps) with a small per-neuron spread. Setting `decay_time_ms`+`frame_rate_hz` (as we do below) shrinks the estimate toward the physical GCaMP8m `g` (Bayesian prior). The pipeline estimates `g` **once** from the raw traces and caches it for every BCD pass — re-estimating from already-deconvolved traces would re-apply the noise-correction factor each time and drift `g` toward 0.\\n\",\n",
    "    \"\\n\",\n",
    "    \"Two strategies are available via `CNMFeParams(global_ar=...)`:\\n\",\n",
    "    \"- `global_ar=True` (default) — one `g` estimated from the pooled concatenation of all K raw traces. More robust on short recordings where per-component Yule-Walker has high variance.\\n\",\n",
    "    \"- `global_ar=False` — `g` estimated separately for each neuron from its own raw trace. More accurate when neurons genuinely have different dynamics (different indicators, different depths).\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"c19\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-05-27T15:09:34.788934250Z\",\n",
    "     \"start_time\": \"2026-05-27T15:09:34.086564482Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"from cnmfe.temporal import estimate_ar_params, deconvolve\\n\",\n",
    "    \"\\n\",\n",
    "    \"trace_raw = C_raw_init[0]\\n\",\n",
    "    \"g_est, sn_est = estimate_ar_params(trace_raw, p=1)\\n\",\n",
    "    \"c_clean, s_train, _ = deconvolve(trace_raw, g_est, sn_est)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f'Estimated g  = {g_est[0]:.3f}   (per-neuron truth ranges {g_true.min():.3f}-{g_true.max():.3f})')\\n\",\n",
    "    \"print(f'Estimated sn = {sn_est:.3f}')\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, axes = plt.subplots(3, 1, figsize=(11, 5), sharex=True)\\n\",\n",
    "    \"axes[0].plot(trace_raw, lw=0.8, color='steelblue'); axes[0].set_ylabel('Raw')\\n\",\n",
    "    \"axes[1].plot(c_clean,   lw=1.0, color='darkorange'); axes[1].set_ylabel('Denoised C')\\n\",\n",
    "    \"axes[2].bar(np.arange(len(s_train)), s_train, width=1, color='forestgreen', linewidth=0)\\n\",\n",
    "    \"axes[2].set_ylabel('Spike train'); axes[2].set_xlabel('Frame')\\n\",\n",
    "    \"plt.suptitle(f'OASIS AR(1) deconvolution  [g={g_est[0]:.3f}]')\\n\",\n",
    "    \"plt.tight_layout(); plt.show()\"\n",
    "   ],\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"Estimated g  = 0.916   (per-neuron truth ranges 0.735-0.774)\\n\",\n",
    "      \"Estimated sn = 0.007\\n\"\n",
    "     ]\n",
    "    },\n",
    "    {\n",
    "     \"data\": {\n",
    "      \"text/plain\": [\n",
    "       \"<Figure size 1320x600 with 3 Axes>\"\n",
    "      ],\n",
    "      \"image/png\": \"\"\n",
    "     },\n",
    "     \"metadata\": {},\n",
    "     \"output_type\": \"display_data\",\n",
    "     \"jetTransient\": {\n",
    "      \"display_id\": null\n",
    "     }\n",
    "    }\n",
    "   ],\n",
    "   \"execution_count\": 12\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"c20\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"---\\n\",\n",
    "    \"## 8. Full pipeline\\n\",\n",
    "    \"\\n\",\n",
    "    \"`CNMFe.fit()` chains everything. We use `sigma=5` (the simulator's neuron size), the GCaMP8m decay prior (`decay_time_ms=180`, `frame_rate_hz=20`), and a `min_pnr` set above the neuropil's PNR floor. On realistic data **expect more detections than truth**: the active neuropil and ghost cells produce many high-CORR, high-PNR seeds that survive as components - the real `demo_session` recording behaves the same way (~108 detected, ~43 retained). `model.accepted_mask` (the SNR auto-eval) flags weak components, and raising `min_pnr` trades recall for precision.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"c21\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-05-27T15:09:55.453612694Z\",\n",
    "     \"start_time\": \"2026-05-27T15:09:41.233618144Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"from cnmfe.pipeline import CNMFe, CNMFeParams\\n\",\n",
    "    \"from tests.test_pipeline import match_components\\n\",\n",
    "    \"\\n\",\n",
    "    \"params = CNMFeParams(\\n\",\n",
    "    \"    sigma=5.0,             # simulator neuron size\\n\",\n",
    "    \"    min_corr=0.90,\\n\",\n",
    "    \"    min_pnr=7.0,           # above the neuropil PNR floor (~10 median)\\n\",\n",
    "    \"    decay_time_ms=180.0,   # GCaMP8m Bayesian g prior\\n\",\n",
    "    \"    frame_rate_hz=20.0,\\n\",\n",
    "    \"    n_iter_main=2,\\n\",\n",
    "    \"    n_iter_temporal=2,\\n\",\n",
    "    \"    mc_n_iter=1,\\n\",\n",
    "    \"    spatial_max_thr=0.1,\\n\",\n",
    "    \"    merge_thr_corr=0.85,\\n\",\n",
    "    \"    merge_thr_overlap=0.5,\\n\",\n",
    "    \"    global_ar=True,        # True = one g from pooled C_raw; False = per-neuron g\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"t0 = time.time()\\n\",\n",
    "    \"model = CNMFe(params).fit(movie, do_motion_correction=False)\\n\",\n",
    "    \"t_wall = time.time() - t0\\n\",\n",
    "    \"\\n\",\n",
    "    \"n_acc = int(model.accepted_mask.sum()) if model.accepted_mask is not None else model.A.shape[1]\\n\",\n",
    "    \"print(f'\\\\nExtracted {model.A.shape[1]} components ({n_acc} pass auto-eval; truth = {K})   wall = {t_wall:.2f}s')\\n\",\n",
    "    \"print(f'A   shape: {model.A.shape}')\\n\",\n",
    "    \"print(f'C   shape: {model.C.shape}')\\n\",\n",
    "    \"print(f'YrA shape: {model.YrA.shape}')\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"c22\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-05-27T15:09:55.797187175Z\",\n",
    "     \"start_time\": \"2026-05-27T15:09:55.471959133Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"# --- Spatial overlay: truth | all extracted | matched-only -----------------\\n\",\n",
    "    \"K_found = model.A.shape[1]\\n\",\n",
    "    \"A_dense = np.asarray(model.A.todense()).reshape(H, W, K_found)\\n\",\n",
    "    \"matches = match_components(model.A, A_true)\\n\",\n",
    "    \"matched_idxs = sorted({k_est for _, k_est, c in matches if c > 0.5})\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, axes = plt.subplots(1, 3, figsize=(13, 4))\\n\",\n",
    "    \"axes[0].imshow(A_true.max(axis=1).reshape(H, W), cmap='hot')\\n\",\n",
    "    \"axes[0].set_title(f'Truth (n={K})'); axes[0].axis('off')\\n\",\n",
    "    \"axes[1].imshow(A_dense.max(axis=2), cmap='hot')\\n\",\n",
    "    \"axes[1].set_title(f'All extracted (n={K_found})'); axes[1].axis('off')\\n\",\n",
    "    \"matched_overlay = A_dense[:, :, matched_idxs].max(axis=2) if matched_idxs else np.zeros((H, W))\\n\",\n",
    "    \"axes[2].imshow(matched_overlay, cmap='hot')\\n\",\n",
    "    \"axes[2].set_title(f'Matched (n={len(matched_idxs)})'); axes[2].axis('off')\\n\",\n",
    "    \"plt.tight_layout(); plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f'Recovered {len(matched_idxs)}/{K} true neurons (spatial r > 0.5)')\\n\",\n",
    "    \"print(f'Extra components: {K_found - len(matched_idxs)}  (mostly neuropil + ghost seeds - the realistic 1p false-positive load)')\\n\",\n",
    "    \"print()\\n\",\n",
    "    \"print('Spatial r per true neuron:')\\n\",\n",
    "    \"for k_true, k_est, corr in sorted(matches):\\n\",\n",
    "    \"    print(f'  true {k_true:2d}  ->  extracted {k_est:2d}    r = {corr:.3f}')\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"c23\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"---\\n\",\n",
    "    \"## 9. Two flavours of the trace, compared to truth and to the raw pixel\\n\",\n",
    "    \"\\n\",\n",
    "    \"| Attribute | What it is | When to use |\\n\",\n",
    "    \"|-----------|-----------|-------------|\\n\",\n",
    "    \"| `model.C[k]` | OASIS-deconvolved | Spike-event detection, smooth amplitude features |\\n\",\n",
    "    \"| `model.C[k] + model.YrA[k]` | Noisy projected trace | Shape-faithful comparisons |\\n\",\n",
    "    \"\\n\",\n",
    "    \"Below we plot, per matched neuron:\\n\",\n",
    "    \"- ground truth (dashed black)\\n\",\n",
    "    \"- `C + YrA` (steelblue) — the data projected onto the footprint\\n\",\n",
    "    \"- `C` only (forestgreen) — OASIS-deconvolved\\n\",\n",
    "    \"- raw single-pixel trace at the neuron's centre (gray)\\n\",\n",
    "    \"\\n\",\n",
    "    \"The raw pixel is heavily dominated by background and bleaching here — that's exactly why the projection matters.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"c24\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-05-27T15:09:55.847297065Z\",\n",
    "     \"start_time\": \"2026-05-27T15:09:55.799985355Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"def pearson(a, b):\\n\",\n",
    "    \"    a = a - a.mean(); b = b - b.mean()\\n\",\n",
    "    \"    d = np.sqrt(np.sum(a ** 2) * np.sum(b ** 2))\\n\",\n",
    "    \"    return float(np.dot(a, b) / d) if d > 0 else 0.0\\n\",\n",
    "    \"\\n\",\n",
    "    \"def norm01(x):\\n\",\n",
    "    \"    lo, hi = float(np.min(x)), float(np.max(x))\\n\",\n",
    "    \"    return (x - lo) / (hi - lo + 1e-10)\\n\",\n",
    "    \"\\n\",\n",
    "    \"C_proj = model.C + model.YrA   # noisy projected trace\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 15\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"c25\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-05-27T15:09:57.020877780Z\",\n",
    "     \"start_time\": \"2026-05-27T15:09:55.848435141Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"# --- (a) C and C + YrA vs ground truth -------------------------------------\\n\",\n",
    "    \"n_rows = len(matches)\\n\",\n",
    "    \"fig, axes = plt.subplots(n_rows, 1, figsize=(11, 1.4 * n_rows), sharex=True)\\n\",\n",
    "    \"if n_rows == 1: axes = [axes]\\n\",\n",
    "    \"for ax, (k_true, k_est, sc) in zip(axes, sorted(matches)):\\n\",\n",
    "    \"    if sc < 0.5:\\n\",\n",
    "    \"        ax.text(0.5, 0.5, f'neuron {k_true}: not recovered (spatial r={sc:.2f})',\\n\",\n",
    "    \"                transform=ax.transAxes, ha='center', va='center', fontsize=8)\\n\",\n",
    "    \"        ax.set_yticks([])\\n\",\n",
    "    \"        continue\\n\",\n",
    "    \"    r_oasis = pearson(model.C[k_est], C_true[k_true])\\n\",\n",
    "    \"    r_proj  = pearson(C_proj[k_est],  C_true[k_true])\\n\",\n",
    "    \"    ax.plot(norm01(C_true[k_true]), lw=1.2, color='black', ls='--', alpha=0.6, label='truth')\\n\",\n",
    "    \"    ax.plot(norm01(C_proj[k_est]),  lw=0.9, color='steelblue',\\n\",\n",
    "    \"            label=f'C + YrA (r={r_proj:.2f})')\\n\",\n",
    "    \"    ax.plot(norm01(model.C[k_est]), lw=0.9, color='forestgreen', alpha=0.7,\\n\",\n",
    "    \"            label=f'C only (r={r_oasis:.2f})')\\n\",\n",
    "    \"    ax.set_ylabel(f'neuron {k_true}', fontsize=8)\\n\",\n",
    "    \"    ax.legend(loc='upper right', fontsize=7, ncol=3)\\n\",\n",
    "    \"axes[-1].set_xlabel('Frame')\\n\",\n",
    "    \"plt.suptitle('Extracted traces vs ground truth (matched neurons, normalised)', fontsize=10)\\n\",\n",
    "    \"plt.tight_layout(); plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"valid = [(kt, ke) for kt, ke, sc in matches if sc > 0.5]\\n\",\n",
    "    \"rs_oasis = [pearson(model.C[ke], C_true[kt])    for kt, ke in valid]\\n\",\n",
    "    \"rs_proj  = [pearson(C_proj[ke],  C_true[kt])    for kt, ke in valid]\\n\",\n",
    "    \"print(f'Mean Pearson r vs truth ({len(valid)} matched):')\\n\",\n",
    "    \"print(f'  C only   = {np.mean(rs_oasis):.3f}')\\n\",\n",
    "    \"print(f'  C + YrA  = {np.mean(rs_proj):.3f}')\"\n",
    "   ],\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"data\": {\n",
    "      \"text/plain\": [\n",
    "       \"<Figure size 1320x3360 with 20 Axes>\"\n",
    "      ],\n",
    "      \"image/png\": \"\"\n",
    "     },\n",
    "     \"metadata\": {},\n",
    "     \"output_type\": \"display_data\",\n",
    "     \"jetTransient\": {\n",
    "      \"display_id\": null\n",
    "     }\n",
    "    },\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"Mean Pearson r vs truth (13 matched):\\n\",\n",
    "      \"  C only   = 0.224\\n\",\n",
    "      \"  C + YrA  = 0.328\\n\"\n",
    "     ]\n",
    "    }\n",
    "   ],\n",
    "   \"execution_count\": 16\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"c26\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-05-27T15:09:58.011835433Z\",\n",
    "     \"start_time\": \"2026-05-27T15:09:57.083883413Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"# --- (b) Raw pixel vs C + YrA vs ground truth ------------------------------\\n\",\n",
    "    \"# A single pixel at the neuron's centre is dominated by background drift and\\n\",\n",
    "    \"# bleaching. Projecting onto the spatial footprint and subtracting bg via\\n\",\n",
    "    \"# the ring model recovers the calcium shape.\\n\",\n",
    "    \"\\n\",\n",
    "    \"n_rows = len(valid)\\n\",\n",
    "    \"fig, axes = plt.subplots(n_rows, 1, figsize=(11, 1.5 * n_rows), sharex=True)\\n\",\n",
    "    \"if n_rows == 1: axes = [axes]\\n\",\n",
    "    \"for ax, (k_true, k_est) in zip(axes, sorted(valid)):\\n\",\n",
    "    \"    r0, c0 = centers[k_true]\\n\",\n",
    "    \"    raw_pixel = movie[:, r0, c0].astype(np.float32)\\n\",\n",
    "    \"    raw_pixel = raw_pixel - raw_pixel.mean()\\n\",\n",
    "    \"    r_raw  = pearson(raw_pixel,        C_true[k_true])\\n\",\n",
    "    \"    r_proj = pearson(C_proj[k_est],    C_true[k_true])\\n\",\n",
    "    \"\\n\",\n",
    "    \"    ax.plot(norm01(raw_pixel),      lw=0.7, color='gray', alpha=0.7,\\n\",\n",
    "    \"            label=f'raw pixel ({r0},{c0}) (r={r_raw:.2f})')\\n\",\n",
    "    \"    ax.plot(norm01(C_proj[k_est]),  lw=0.9, color='steelblue',\\n\",\n",
    "    \"            label=f'C + YrA (r={r_proj:.2f})')\\n\",\n",
    "    \"    ax.plot(norm01(C_true[k_true]), lw=1.2, color='black', ls='--', alpha=0.6, label='truth')\\n\",\n",
    "    \"    ax.set_ylabel(f'neuron {k_true}', fontsize=8)\\n\",\n",
    "    \"    ax.legend(loc='upper right', fontsize=7, ncol=3)\\n\",\n",
    "    \"axes[-1].set_xlabel('Frame')\\n\",\n",
    "    \"plt.suptitle('Raw single-pixel vs C + YrA vs truth — bg/bleach/vasc dominate the raw trace', fontsize=10)\\n\",\n",
    "    \"plt.tight_layout(); plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"rs_raw  = [pearson(movie[:, centers[kt][0], centers[kt][1]].astype(np.float32),\\n\",\n",
    "    \"                   C_true[kt]) for kt, _ in valid]\\n\",\n",
    "    \"print(f'Mean Pearson r vs truth ({len(valid)} matched):')\\n\",\n",
    "    \"print(f'  raw pixel = {np.mean(rs_raw):.3f}')\\n\",\n",
    "    \"print(f'  C + YrA   = {np.mean(rs_proj):.3f}')\"\n",
    "   ],\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"data\": {\n",
    "      \"text/plain\": [\n",
    "       \"<Figure size 1320x2340 with 13 Axes>\"\n",
    "      ],\n",
    "      \"image/png\": \"\"\n",
    "     },\n",
    "     \"metadata\": {},\n",
    "     \"output_type\": \"display_data\",\n",
    "     \"jetTransient\": {\n",
    "      \"display_id\": null\n",
    "     }\n",
    "    },\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"Mean Pearson r vs truth (13 matched):\\n\",\n",
    "      \"  raw pixel = 0.118\\n\",\n",
    "      \"  C + YrA   = 0.328\\n\"\n",
    "     ]\n",
    "    }\n",
    "   ],\n",
    "   \"execution_count\": 17\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"c27\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"---\\n\",\n",
    "    \"## 10. Summary\\n\",\n",
    "    \"\\n\",\n",
    "    \"The realistic movie is calibrated to a real clean recording, so it reproduces the regime CNMFe actually faces. Expect:\\n\",\n",
    "    \"\\n\",\n",
    "    \"- **More extracted components than truth** - the active neuropil and ghost cells produce many high-CORR/PNR seeds. This is real: the `demo_session` recording yields ~108 detections, ~43 retained. Raise `min_pnr` or filter with `model.accepted_mask` to trade recall for precision.\\n\",\n",
    "    \"- **Most true neurons recovered** with good footprints (spatial r >~ 0.75 on matched cells); `C + YrA` tracks truth well, `C` alone runs a little lower (OASIS shape constraint).\\n\",\n",
    "    \"\\n\",\n",
    "    \"Difficulty / realism knobs in `make_miniscope_movie`:\\n\",\n",
    "    \"\\n\",\n",
    "    \"| Knob | Default | Effect |\\n\",\n",
    "    \"|------|---------|--------|\\n\",\n",
    "    \"| `difficulty` | 0.0 | 0 = clean (calibrated to real); -> 1 raises neuropil + noise, dims neurons |\\n\",\n",
    "    \"| `realism` | True | `False` = legacy low-DC fixture (no neuropil/haloes, small neurons) |\\n\",\n",
    "    \"| `npil_strength` | 9.0 | Active-neuropil amplitude (the dominant background) |\\n\",\n",
    "    \"| `neuron_gain` | auto | Foreground-neuron ΔF amplitude |\\n\",\n",
    "    \"| `n_ghost_cells` | 10 | Out-of-focus false-positive sources |\\n\",\n",
    "    \"| `f0_base` | 42 | Median uint8-like baseline |\\n\",\n",
    "    \"| `photon_scale` | auto | Lower = more (intensity-dependent) shot noise |\\n\",\n",
    "    \"| `vasc_strength` / `vignette_strength` / `photobleach_tau_factor` | 0.5 / 0.4 / 3.0 | Vasculature / corner darkening / bleach |\\n\",\n",
    "    \"\\n\",\n",
    "    \"Pass `realism=False` (or `difficulty=0` with `npil_strength=0`, `shot_noise=False`, `n_ghost_cells=0`) to approach the clean tutorial fixture.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"c28\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"---\\n\",\n",
    "    \"## 11. Parallelism\\n\",\n",
    "    \"\\n\",\n",
    "    \"Same options as on the clean movie - `n_jobs` for CPU, `device='cuda'` for GPU. On a 128x128x500 movie with realistic clutter the per-frame work is bigger than the toy 64x64x300, so `n_jobs=4` already starts to pay off.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"c29\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-05-27T15:10:20.879834829Z\",\n",
    "     \"start_time\": \"2026-05-27T15:09:58.076509083Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"demo_params = dict(sigma=5.0, min_corr=0.90, min_pnr=7.0, decay_time_ms=180.0,\\n\",\n",
    "    \"                   frame_rate_hz=20.0, n_iter_main=2, n_iter_temporal=2, mc_n_iter=1)\\n\",\n",
    "    \"\\n\",\n",
    "    \"t0 = time.time()\\n\",\n",
    "    \"serial_model = CNMFe(CNMFeParams(**demo_params, n_jobs=1)).fit(movie, do_motion_correction=False)\\n\",\n",
    "    \"t_serial = time.time() - t0\\n\",\n",
    "    \"\\n\",\n",
    "    \"t0 = time.time()\\n\",\n",
    "    \"par_model = CNMFe(CNMFeParams(**demo_params, n_jobs=4)).fit(movie, do_motion_correction=False)\\n\",\n",
    "    \"t_parallel = time.time() - t0\\n\",\n",
    "    \"\\n\",\n",
    "    \"print()\\n\",\n",
    "    \"print(f'Serial   (n_jobs=1):  {t_serial:5.2f}s   neurons = {serial_model.A.shape[1]}')\\n\",\n",
    "    \"print(f'Parallel (n_jobs=4):  {t_parallel:5.2f}s   neurons = {par_model.A.shape[1]}')\\n\",\n",
    "    \"print(f'Speedup: {t_serial / t_parallel:4.2f}x')\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"outputs\": [],\n",
